# Copy to ~/.nao-secrets and fill in values.
# Never commit the filled-in version.
#
# Step 1 — before running setup.sh:
#   source ~/.nao-secrets && bash setup.sh
#
# Step 2 — after setup.sh prints the RDS endpoints, fill in the URLs below.
#   Then on the EC2: source ~/.nao-secrets && bash deploy.sh

# ── Required before setup.sh ──────────────────────────────────────────────────
export NAO_DB_PASSWORD="<password-for-nao-metadata-rds>"
export DATA_SOURCE_RDS_INSTANCE="<aws-rds-instance-identifier>"
export OPENAI_API_KEY="sk-..."
export GITHUB_TOKEN="ghp_..."
export GITHUB_REPO="https://github.com/your-org/your-repo"

# ── Filled in after setup.sh (outputs these endpoints) ───────────────────────
export NAO_METADATA_URL="postgres://nao_user:${NAO_DB_PASSWORD}@<rds-metadata-endpoint>:5432/nao_db"
export DATA_SOURCE_HOST="<rds-datasource-endpoint>"
export DATA_SOURCE_DB_NAME="postgres"
export DATA_SOURCE_USER="postgres"
export DATA_SOURCE_PASSWORD="<password>"
